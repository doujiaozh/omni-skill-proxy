# Omni-Skill-Proxy 运行配置示例 / sample configuration

# 真实上游地址（必填 / required）——任选一家：
#   Intern InkStone:  https://api.intern-ai.cn
#   OpenAI:          https://api.openai.com
#   Anthropic:       https://api.anthropic.com
UPSTREAM_BASE_URL=https://api.intern-ai.cn

# 上游 API Key
UPSTREAM_API_KEY=sk-your-api-key-here

# 本地监听 / local listen
HOST=127.0.0.1
PORT=8888

# 技能目录 / skills directory
SKILLS_DIR=skills

# 注入与剥离开关 / inject & strip switches
INJECT=1
STRIP=1
MAX_HOLD_CHARS=200
